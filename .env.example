# Server port
PORT=3000

# Agar Gemini AI dan foydalanmoqchi bo'lsangiz, API kalitingizni kiriting:
# Kalitni olish: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Sayt orqali kelgan xabarlar Telegramingizga kelishi uchun:
# 1. @BotFather dan olingan bot tokeni (masalan: 7823482349:AAFn...)
TELEGRAM_BOT_TOKEN=
# 2. @userinfobot dan olingan sizning Telegram Chat ID raqamingiz (masalan: 123456789)
TELEGRAM_CHAT_ID=
